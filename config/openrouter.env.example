# Copy this file to config/openrouter.local.env and replace placeholders.
# config/openrouter.local.env is ignored by .gitignore; keep real keys there, not in docs.

OPENAI_API_KEY=<PASTE_OPENROUTER_KEY_HERE>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Throughline Smoke Test
# Optional attribution header. Use a real project/page URL if you have one.
OPENROUTER_SITE_URL=https://example.local

# Default model for one-off runs. Matrix runs override this per model.
MODEL=anthropic/claude-sonnet-4.5

# Probe defaults; CLI flags can override these.
TEMPERATURE=0.7
MAX_TOKENS=1800
REQUEST_TIMEOUT=180
REQUEST_SLEEP=0
